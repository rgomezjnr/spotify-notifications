{
   "author": "ViaxCo",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "https://open.spotify.com/*" ]
   } ],
   "description": "Displays notifications when the song changes on Spotify, using the album cover as the icon.",
   "host_permissions": [ "https://open.spotify.com/*" ],
   "icons": {
      "128": "icon.png",
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
   },
   "manifest_version": 3,
   "name": "Spotify Notifications",
   "permissions": [ "notifications", "tabs", "scripting" ],
   "version": "1.1.0"
}
